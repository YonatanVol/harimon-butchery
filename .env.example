# Local Postgres 17 (Homebrew). Copy to .env.local.
DATABASE_URL=postgres://USER@localhost:5432/meatstore_dev
DATABASE_URL_TEST=postgres://USER@localhost:5432/meatstore_test
SESSION_SECRET=generate-with: node -e "console.log(require(\"crypto\").randomBytes(32).toString(\"base64url\"))"
PAYMENT_PROVIDER=MOCK
APP_URL=http://localhost:3000

# Real PayPlus sandbox (optional). Set PAYMENT_PROVIDER=PAYPLUS and all five values; you enter these yourself.
# Missing any of them with PAYMENT_PROVIDER=PAYPLUS stops the app with a clear error — it never falls back to demo payments.
PAYPLUS_ENV=sandbox
PAYPLUS_API_KEY=
PAYPLUS_SECRET_KEY=
PAYPLUS_PAYMENT_PAGE_UID=
PAYPLUS_TERMINAL_UID=
PAYPLUS_CASHIER_UID=

# Real WhatsApp / SMS (optional). Without credentials, messages are recorded in the staff timeline, not sent.
NOTIFICATIONS_PROVIDER=MOCK
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INFORU_USER=
INFORU_TOKEN=
INFORU_SENDER=
