{
  "name": "meat-store",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint && tsx scripts/verify-rtl.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "TZ=UTC vitest run",
    "test:watch": "TZ=UTC vitest",
    "db:setup": "bash scripts/db-setup.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:test": "DATABASE_URL=$(grep DATABASE_URL_TEST .env.local | cut -d= -f2-) drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:empty": "tsx scripts/seed.ts --empty",
    "db:reset": "bash scripts/db-reset.sh",
    "test:integration": "TZ=UTC vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "payplus:check": "tsx scripts/payplus-check.ts"
  },
  "dependencies": {
    "@hebcal/core": "^6.9.2",
    "better-auth": "^1.7.4",
    "drizzle-orm": "^0.45.2",
    "libphonenumber-js": "^1.13.13",
    "next": "16.3.5",
    "next-intl": "^4.14.4",
    "pg": "^8.23.0",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "fast-check": "^4.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.0"
  }
}
